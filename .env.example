# Google Gemini API key (required for Deep Research)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_api_key_here

# Alternative: GEMINI_API_KEY is also supported
# GEMINI_API_KEY=your_api_key_here

# --- For public HTTP deployment only ---
# API key for X-API-Key header auth (clients must send this to connect)
# Generate a strong random secret, e.g.: openssl rand -hex 32
MCP_API_KEY=your_mcp_secret_here

# HTTP server settings (optional, defaults shown)
# MCP_TRANSPORT=http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
